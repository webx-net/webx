// HTMX CRUD: endpoint blocks return HTML fragments.
// PUT receives named form fields in the request body; POST uses a URL segment.
global {
    let todos = [];
    let nextId = 1;

    function escapeHtml(value) {
        return String(value).replaceAll("&", "&amp;").replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;").replaceAll('"', "&quot;").replaceAll("'", "&#39;");
    }
    function renderTodo(todo, editingId) {
        if (String(todo.id) === editingId) {
            return `<li id="todo-${todo.id}">
                <form hx-put="/todos/${todo.id}">
                    <label for="edit-title-${todo.id}">Title</label>
                    <input id="edit-title-${todo.id}" name="title" type="text" value="${escapeHtml(todo.title)}" maxlength="120" required>
                    <label><input name="completed" type="checkbox" value="true" ${todo.completed ? "checked" : ""}> Completed</label>
                    <button type="submit">Save</button>
                    <button type="button" hx-get="/todos">Cancel</button>
                </form>
            </li>`;
        }
        return `<li id="todo-${todo.id}">
            <span class="todo-title">${escapeHtml(todo.title)}</span>
            <span class="todo-state">${todo.completed ? "Completed" : "Pending"}</span>
            <button type="button" hx-get="/todos/${todo.id}">Edit</button>
            <button type="button" hx-delete="/todos/${todo.id}">Delete</button>
        </li>`;
    }
    function renderTodos(message, editingId) {
        const rows = todos.map(todo => renderTodo(todo, editingId)).join("");
        return `<section id="todo-panel">
            <p id="status" role="status">${escapeHtml(message || "")}</p>
            <ul id="todos">${rows || '<li class="empty">No todos yet.</li>'}</ul>
            <form id="create" hx-post="/todos" hx-params="none" data-title-route>
                <label for="new-title">New todo</label>
                <input id="new-title" name="title" type="text" placeholder="What needs doing?" maxlength="120" required>
                <button type="submit">Add todo</button>
            </form>
        </section>`;
    }
}

get / -> static("index.html")

get /todos {
    return renderTodos("");
}

get /todos/(id: String) {
    const todo = todos.find(item => String(item.id) === id);
    return todo ? renderTodos("", id) : renderTodos("Todo not found");
}

post /todos/(encodedTitle: String) {
    let title;
    try { title = decodeURIComponent(encodedTitle).trim(); }
    catch (error) { return renderTodos("Title must contain 1-120 characters"); }
    if (!title || title.length > 120) return renderTodos("Title must contain 1-120 characters");
    todos.push({ id: nextId++, title, completed: false });
    return renderTodos("Todo added");
}

put /todos/(id: String) form(title: String, completed: Boolean) {
    const todo = todos.find(item => String(item.id) === id);
    if (!todo) return renderTodos("Todo not found");
    const cleanedTitle = title.trim();
    if (!cleanedTitle || cleanedTitle.length > 120) return renderTodos("Title must contain 1-120 characters", id);
    todo.title = cleanedTitle;
    todo.completed = completed;
    return renderTodos("Todo updated");
}

delete /todos/(id: String) {
    const todo = todos.find(item => String(item.id) === id);
    if (!todo) return renderTodos("Todo not found");
    todos = todos.filter(item => String(item.id) !== id);
    return renderTodos("Todo deleted");
}
